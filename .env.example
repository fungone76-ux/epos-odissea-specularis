# ============================================================================
# epos — configurazione ambiente
# Copia questo file come ".env" e inserisci i tuoi valori reali.
# NON committare mai il file .env con le chiavi vere (è già in .gitignore).
# Le variabili d'ambiente già impostate nel sistema hanno precedenza sul file.
# ============================================================================

# ---------------------------------------------------------------------------
# GAME MASTER (LLM narrativa) — qualunque endpoint OpenAI-compatibile:
# OpenAI, OpenRouter, LM Studio, llama.cpp, Ollama (modalità openai), ecc.
# Si attiva con:  --provider live
# ---------------------------------------------------------------------------
EPOS_LLM_BASE_URL=https://api.openai.com/v1
EPOS_LLM_MODEL=gpt-4o-mini
EPOS_LLM_API_KEY=la-tua-chiave

# ---------------------------------------------------------------------------
# GEMINI come GM (endpoint OpenAI-compatibile di Google, come nel vecchio gioco):
#   EPOS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   EPOS_LLM_MODEL=gemini-2.5-flash          (o gemini-2.5-pro per qualità)
#   EPOS_LLM_API_KEY=<la tua GEMINI_API_KEY>
# oppure tieni la chiave col suo nome classico e punta ad essa:
#   GEMINI_API_KEY=<la tua chiave>
#   EPOS_LLM_KEY_ENV=GEMINI_API_KEY
# ---------------------------------------------------------------------------

# Opzionale: se la chiave sta in una variabile con altro nome (es. OPENAI_API_KEY)
# EPOS_LLM_KEY_ENV=OPENAI_API_KEY

# ---------------------------------------------------------------------------
# RENDERER IMMAGINI
# pending  = nessun rendering, il turno salva solo il prompt (default)
# comfy    = ComfyUI locale o pod
# a1111    = Stable Diffusion WebUI Forge/Automatic1111 via API
# novelai  = NovelAI API
# ---------------------------------------------------------------------------
EPOS_RENDER_MODE=a1111

# ---------------------------------------------------------------------------
# PROMPT VISIVO
# EPOS_PROMPT_PROSE=0 esclude la prosa di scena dal prompt (Pony lavora
# meglio a soli tag booru); la prosa resta nel debug del turno.
# ---------------------------------------------------------------------------
EPOS_PROMPT_PROSE=1

# --- A1111 / Forge (EPOS_RENDER_MODE=a1111) --------------------------------
# 127.0.0.1:17860 e' un tunnel SSH locale verso Forge remoto.
# La finestra del tunnel deve restare aperta mentre giochi.
A1111_BASE_URL=http://127.0.0.1:7860
A1111_TIMEOUT_SECONDS=600
A1111_CHECKPOINT=cyberrealisticPony_v7.safetensors
EPOS_A1111_STEPS=18
EPOS_A1111_WIDTH=512
EPOS_A1111_HEIGHT=704
EPOS_A1111_CFG=3.0
EPOS_A1111_SAMPLER=DPM++ 2M Karras

# --- ComfyUI (EPOS_RENDER_MODE=comfy) --------------------------------------
# Workflow API-format con nodi canonici:
# 1 checkpoint, 2 positive, 3 negative, 4 sampler, 5 sampler select,
# 6 scheduler, 7 latent, 8 VAE decode, 9 save, 20-25 LoraLoader.
COMFYUI_BASE_URL=http://127.0.0.1:18188
COMFYUI_TIMEOUT_SECONDS=600
COMFYUI_CHECKPOINT=luna_main_model.safetensors
EPOS_COMFY_WORKFLOW=percorso/del/workflow_api.json
# Compatibilita' legacy: usata solo se COMFYUI_BASE_URL non e' definita.
EPOS_COMFY_URL=http://127.0.0.1:8188
EPOS_COMFY_TIMEOUT_SECONDS=180
EPOS_COMFY_POLL_SECONDS=1

# --- NovelAI (EPOS_RENDER_MODE=novelai) -------------------------------------
EPOS_NOVELAI_API_KEY=
EPOS_NOVELAI_MODEL=nai-diffusion-4-5-full
